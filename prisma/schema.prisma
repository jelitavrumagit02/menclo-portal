// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  employeeId      String    @unique
  email           String    @unique
  password        String
  role            String    @default("employee") // employee | owner | hrd | admin
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  employee        Employee?
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@map("users")
}

model Store {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  location    String
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees         Employee[]
  sales             Sale[]
  inventory         Inventory[]
  inventoryMovements InventoryMovement[]
  defectiveProducts DefectiveProduct[]
  attendance        Attendance[]
  announcements     Announcement[]

  @@map("stores")
}

model Position {
  id          String    @id @default(cuid())
  name        String    @unique
  level       Int       @default(1)
  description String?
  createdAt   DateTime  @default(now())

  employees   Employee[]

  @@map("positions")
}

model Employee {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeCode    String    @unique
  fullName        String
  storeId         String
  positionId      String
  phone           String?
  address         String?
  birthDate       DateTime?
  hireDate        DateTime
  terminationDate DateTime?
  status          String    @default("active") // active | inactive | terminated
  basicSalary     Float     @default(0)
  photoUrl        String?
  emergencyContact String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id])
  store           Store     @relation(fields: [storeId], references: [id])
  position        Position  @relation(fields: [positionId], references: [id])

  sales             Sale[]
  attendance        Attendance[]
  leaveRequests     LeaveRequest[]
  payrolls          Payroll[]
  benefits          EmployeeBenefit[]
  deductions        EmployeeDeduction[]
  warnings          EmployeeWarning[]
  inventoryMovements InventoryMovement[]
  defectiveProducts DefectiveProduct[]
  announcementTargets AnnouncementTarget[]

  @@map("employees")
}

model ProductCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("product_categories")
}

model Product {
  id              String    @id @default(cuid())
  articleCode     String    @unique
  name            String
  categoryId      String
  sellingPrice    Float
  costPrice       Float?
  minStock        Int       @default(5)
  description     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        ProductCategory @relation(fields: [categoryId], references: [id])

  saleItems       SaleItem[]
  inventory       Inventory[]
  inventoryMovements InventoryMovement[]
  defectiveProducts  DefectiveProduct[]

  @@map("products")
}

model Bazaar {
  id          String    @id @default(cuid())
  name        String
  location    String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())

  sales       Sale[]

  @@map("bazaars")
}

model Sale {
  id              String    @id @default(cuid())
  saleDate        DateTime  @default(now())
  employeeId      String
  storeId         String?
  bazaarId        String?
  locationType    String    // store | bazaar
  totalAmount     Float
  totalItems      Int
  notes           String?
  status          String    @default("confirmed") // draft | confirmed | cancelled
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee  @relation(fields: [employeeId], references: [id])
  store           Store?    @relation(fields: [storeId], references: [id])
  bazaar          Bazaar?   @relation(fields: [bazaarId], references: [id])

  items           SaleItem[]

  @@map("sales")
}

model SaleItem {
  id            String    @id @default(cuid())
  saleId        String
  productId     String
  quantity      Int
  sellingPrice  Float
  totalPrice    Float
  createdAt     DateTime  @default(now())

  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  storeId     String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  store       Store     @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@map("inventory")
}

model InventoryMovement {
  id            String    @id @default(cuid())
  productId     String
  storeId       String
  employeeId    String
  movementType  String    // incoming | outgoing | transfer | adjustment
  quantity      Int
  movementDate  DateTime  @default(now())
  description   String?
  referenceId   String?
  status        String    @default("pending") // pending | approved | rejected
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  product       Product   @relation(fields: [productId], references: [id])
  store         Store     @relation(fields: [storeId], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@map("inventory_movements")
}

model DefectiveProduct {
  id            String    @id @default(cuid())
  productId     String
  storeId       String
  employeeId    String
  quantity      Int
  reportDate    DateTime  @default(now())
  description   String
  photoUrl      String?
  status        String    @default("pending") // pending | reviewed | resolved
  reviewedBy    String?
  reviewedAt    DateTime?
  resolution    String?
  createdAt     DateTime  @default(now())

  product       Product   @relation(fields: [productId], references: [id])
  store         Store     @relation(fields: [storeId], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@map("defective_products")
}

model Attendance {
  id              String    @id @default(cuid())
  employeeId      String
  storeId         String
  attendanceDate  DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  shiftType       String    // shift1 | shift2 | jp | overtime | off | leave
  workDuration    Float?    // in hours
  isLate          Boolean   @default(false)
  lateMinutes     Int?
  overtimeHours   Float?
  notes           String?
  photoUrl        String?
  payrollPeriodId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee      @relation(fields: [employeeId], references: [id])
  store           Store         @relation(fields: [storeId], references: [id])
  payrollPeriod   PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@map("attendance")
}

model PayrollPeriod {
  id            String    @id @default(cuid())
  periodName    String
  startDate     DateTime
  endDate       DateTime
  closingDate   DateTime?
  status        String    @default("open") // open | closed
  createdAt     DateTime  @default(now())

  attendance    Attendance[]
  payrolls      Payroll[]

  @@map("payroll_periods")
}

model BenefitType {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isFixed     Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  employeeBenefits EmployeeBenefit[]
  payrollItems     PayrollItem[]

  @@map("benefit_types")
}

model DeductionType {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isFixed     Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  employeeDeductions EmployeeDeduction[]
  payrollItems       PayrollItem[]

  @@map("deduction_types")
}

model EmployeeBenefit {
  id              String    @id @default(cuid())
  employeeId      String
  benefitTypeId   String
  amount          Float
  effectiveDate   DateTime
  expiryDate      DateTime?
  isRecurring     Boolean   @default(true)
  createdAt       DateTime  @default(now())

  employee        Employee    @relation(fields: [employeeId], references: [id])
  benefitType     BenefitType @relation(fields: [benefitTypeId], references: [id])

  @@map("employee_benefits")
}

model EmployeeDeduction {
  id              String    @id @default(cuid())
  employeeId      String
  deductionTypeId String
  amount          Float
  effectiveDate   DateTime
  expiryDate      DateTime?
  isRecurring     Boolean   @default(true)
  createdAt       DateTime  @default(now())

  employee        Employee      @relation(fields: [employeeId], references: [id])
  deductionType   DeductionType @relation(fields: [deductionTypeId], references: [id])

  @@map("employee_deductions")
}

model Payroll {
  id              String    @id @default(cuid())
  employeeId      String
  payrollPeriodId String
  basicSalary     Float
  grossSalary     Float
  totalDeductions Float
  netSalary       Float
  overtimePay     Float     @default(0)
  status          String    @default("draft") // draft | review | approved | paid
  paidAt          DateTime?
  paidBy          String?
  notes           String?
  notificationSent Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  items           PayrollItem[]

  @@unique([employeeId, payrollPeriodId])
  @@map("payrolls")
}

model PayrollItem {
  id              String    @id @default(cuid())
  payrollId       String
  itemType        String    // benefit | deduction | overtime | base
  benefitTypeId   String?
  deductionTypeId String?
  name            String
  amount          Float
  createdAt       DateTime  @default(now())

  payroll         Payroll        @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  benefitType     BenefitType?   @relation(fields: [benefitTypeId], references: [id])
  deductionType   DeductionType? @relation(fields: [deductionTypeId], references: [id])

  @@map("payroll_items")
}

model LeaveRequest {
  id              String    @id @default(cuid())
  employeeId      String
  leaveType       String    // annual | sick | personal | maternity | emergency
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String
  attachmentUrl   String?
  status          String    @default("pending") // pending | approved | rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewComment   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("leave_requests")
}

model EmployeeWarning {
  id              String    @id @default(cuid())
  employeeId      String
  warningLevel    String    // verbal | written | final
  category        String
  warningDate     DateTime
  description     String
  documentUrl     String?
  issuedBy        String
  status          String    @default("active") // active | resolved
  createdAt       DateTime  @default(now())

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_warnings")
}

model Announcement {
  id              String    @id @default(cuid())
  title           String
  content         String
  attachmentUrl   String?
  publishDate     DateTime  @default(now())
  expiryDate      DateTime?
  createdBy       String
  storeId         String?
  targetType      String    @default("all") // all | store | position | individual
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  store           Store?    @relation(fields: [storeId], references: [id])
  targets         AnnouncementTarget[]
  reads           AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementTarget {
  id              String    @id @default(cuid())
  announcementId  String
  employeeId      String

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id])

  @@unique([announcementId, employeeId])
  @@map("announcement_targets")
}

model AnnouncementRead {
  id              String    @id @default(cuid())
  announcementId  String
  userId          String
  readAt          DateTime  @default(now())

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String    // payroll | leave | attendance | announcement | system
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id              String    @id @default(cuid())
  userId          String
  userName        String
  action          String
  module          String
  recordId        String?
  previousValue   String?
  newValue        String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
